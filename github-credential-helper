#!/bin/sh

[ "$1" = "get" ] || exit 0
[ -n "${GITHUB_TOKEN:-}" ] || exit 0

protocol=
host=
while IFS='=' read -r key value; do
    case "$key" in
        protocol) protocol=$value ;;
        host) host=$value ;;
    esac
done

case "$host" in
    github.com|github.com:443)
        if [ "$protocol" = "https" ]; then
            printf 'username=x-access-token\npassword=%s\n' "$GITHUB_TOKEN"
        fi
        ;;
esac
